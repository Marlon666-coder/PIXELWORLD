# ─────────────────────────────────────────────────────────────────────────────
# PIXEL QUEST — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). NEVER commit `.env.local` or real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (recommended) — safe to expose in the browser.
# Supabase Dashboard → Project Settings → API keys → "Publishable key" (sb_publishable_...).
# RLS protects your data; this key only ever acts as the anon/authenticated role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Legacy alternative ────────────────────────────────────────────────────────
# If your project still uses the legacy anon key, set this INSTEAD of the
# publishable key above. The app accepts either (publishable takes precedence).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional (public) ─────────────────────────────────────────────────────────

# Absolute site URL for Open Graph / canonical links (no trailing slash).
# On Vercel this is auto-detected from the deployment domain; set it to pin a
# custom production domain, e.g. https://pixel-quest.example.com
# NEXT_PUBLIC_SITE_URL=

# IANA time zone used to display dates and to interpret the wall-clock times
# admins type into the form. Defaults to UTC. Example: Asia/Jakarta
# NEXT_PUBLIC_SITE_TIMEZONE=UTC

# Maximum poster upload size in megabytes (0.1–50). Defaults to 5.
# Keep this in sync with the competition-posters bucket's file_size_limit.
# NEXT_PUBLIC_POSTER_MAX_MB=5

# ── Do NOT put secrets here ───────────────────────────────────────────────────
# The application never uses the Supabase service_role / secret key. It is only
# needed by the optional demo seeder (scripts/seed-demo.mjs) and by integration
# tests — provide it ONLY in a trusted shell, never via a NEXT_PUBLIC_ variable
# and never committed:
#   SUPABASE_URL=
#   SUPABASE_SECRET_KEY=
